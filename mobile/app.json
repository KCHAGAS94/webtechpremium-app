{
  "expo": {
    "name": "WebTech Premium",
    "slug": "webtech-premium",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.webtechpremium.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0a0a1a"
      }
    },
    "ios": {
      "bundleIdentifier": "com.webtechpremium.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-brightness"
    ],
    "scheme": "webtechpremium"
  }
}
