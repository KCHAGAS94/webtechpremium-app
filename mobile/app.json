{
  "expo": {
    "name": "WebTech Premium",
    "slug": "webtechpremium-app",
    "version": "1.1.0",
    "orientation": "landscape",
    "icon": "./assets/images/logo_quadrada.png",
    "userInterfaceStyle": "dark",
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.webtechpremium.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_quadrada.png",
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "android.permission.WRITE_SETTINGS"
      ],
      "versionCode": 13
    },
    "ios": {
      "bundleIdentifier": "com.webtechpremium.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withLargeHeap",
      "expo-video",
      "expo-brightness",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_quadrada_sem_fundo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#04041a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845"
        }
      ],
      "expo-font"
    ],
    "scheme": "webtechpremium",
    "extra": {
      "eas": {
        "projectId": "b8d35b29-b969-4491-babd-42887d2d6950"
      }
    },
    "owner": "kchagasdevs-team"
  }
}
