{
  "expo": {
    "name": "WebTech Premium",
    "slug": "webtechpremium-app",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.webtechpremium.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.webtechpremium.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-brightness",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "webtechpremium",
    "extra": {
      "eas": {
        "projectId": "b8d35b29-b969-4491-babd-42887d2d6950"
      }
    },
    "owner": "kchagasdevs-team"
  }
}
