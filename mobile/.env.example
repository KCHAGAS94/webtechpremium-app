# the movie/series player. Unlike OpenSubtitles' free tier, SubDL's free key
# officially supports app usage (2,000 requests/day). Leave blank to disable.
EXPO_PUBLIC_SUBDL_API_KEY=subdl_AK2uIZV5WVNVePE7KM8DcK-brZVY2mr3cT7cFD8YGL0

# No longer used (kept in case of rollback) — OpenSubtitles' free "consumer"
# tier explicitly disallows shipping it inside an app; see subdl-api.ts.
EXPO_PUBLIC_OPENSUBTITLES_API_KEY=
