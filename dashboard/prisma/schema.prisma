// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apps App[]
}

model App {
  id        Int     @id @default(autoincrement())
  name      String
  macAddress String @unique
  version   String
  status    String @default("active") // active, inactive, suspended
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Panel-only fields the "Usuários" screen edits (usuario, password, dns,
  // expiracaoData, expirado) that don't have dedicated columns yet — stored
  // as one JSON blob instead of a migration per field.
  metadata  Json?

  sessions  Session[]
  listas    Lista[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Session {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  appId     Int
  app       App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([appId])
}

model Servidor {
  id        Int      @id @default(autoincrement())
  nome      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listas Lista[]
}

model Lista {
  id            Int       @id @default(autoincrement())
  nome          String
  usuario       String
  senha         String
  dataExpiracao DateTime?
  isActive      Boolean   @default(true)
  appId         Int
  app           App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  servidorId    Int
  servidor      Servidor  @relation(fields: [servidorId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([appId])
  @@index([servidorId])
}
