// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REVENDA
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(REVENDA)
  credits   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apps                    App[]
  creditPurchases         CreditPurchase[]
  transferenciasAtivacao  TransferenciaAtivacao[]
  listasCriadas           Lista[]                  @relation("ListaCriadoPor")
}

enum CreditPurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  PIX
  CARD
}

// Uma linha por tentativa de compra de créditos via Mercado Pago. `status`
// começa PENDING e só vira APPROVED quando o pagamento é confirmado (via
// polling em /api/creditos/status ou via webhook em /api/creditos/webhook)
// — é nesse momento, e só uma vez por mpPaymentId, que os créditos são
// somados ao User.
model CreditPurchase {
  id            Int                   @id @default(autoincrement())
  userId        Int
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits       Int
  amount        Float
  paymentMethod PaymentMethod
  status        CreditPurchaseStatus  @default(PENDING)
  mpPaymentId   String                @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([userId])
}

model App {
  id        Int     @id @default(autoincrement())
  name      String
  macAddress String @unique
  version   String
  status    String @default("active") // active, inactive, suspended
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Panel-only fields the "Usuários" screen edits (usuario, password, dns,
  // expiracaoData, expirado) that don't have dedicated columns yet — stored
  // as one JSON blob instead of a migration per field.
  metadata  Json?

  sessions  Session[]
  listas    Lista[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Session {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  appId     Int
  app       App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([appId])
}

// usuario/senha/servidor were merged into a single manually-pasted M3U link
// (e.g. http://host:port/get.php?username=...&password=...&type=m3u_plus) —
// the reseller now pastes the full URL instead of the panel building it from
// three separate fields.
//
// A device's playlists can come from two places: a reseller assigning one in
// the painel ("Usuários"), or the end user pasting their own directly in the
// app's "Gerenciamento de Playlist" screen (not every MAC has a reseller who
// bothers linking a list). Both feed the same device — `origem` distinguishes
// them so /api/devices can prioritize PAINEL over APP without a second table.
// `criadoPorId` é quem cadastrou essa linha pelo painel (tela "Usuários" ou
// "Ativação App") — diferente de `app.userId`, que é o dono do dispositivo.
// Sem isso, um admin cadastrando lista num MAC que pertence a um revendedor
// fazia essa linha aparecer na tela "Usuários" do revendedor, mesmo sem ele
// ter feito nada. Nulo em linhas antigas, criadas antes desse campo existir,
// e em linhas criadas pelo próprio app do usuário final (`origem: APP`), que
// não têm um usuário do painel por trás.
model Lista {
  id            Int         @id @default(autoincrement())
  nome          String
  url           String      @default("")
  dataExpiracao DateTime?
  isActive      Boolean     @default(true)
  origem        ListaOrigem @default(PAINEL)
  tipo          TipoAtivacao?
  appId         Int
  app           App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  criadoPorId   Int?
  criadoPor     User?       @relation("ListaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  // PIN opcional (hash bcrypt) que o próprio usuário final define ao
  // cadastrar uma lista pela tela pública "Gerenciamento de Playlist"
  // ("Proteja sua playlist com um PIN"). Só se aplica a origem APP — exige
  // digitar o PIN certo antes de editar ou excluir essa lista por lá.
  pinHash       String?
  // Nota livre do revendedor/admin sobre onde esse MAC está instalado (ex.
  // "sala de estar - cliente João"). Puramente informativa, não afeta a
  // ativação em si.
  observacao    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appId])
  @@index([criadoPorId])
}

enum ListaOrigem {
  PAINEL
  APP
}

// Tipo de ativação escolhido ao criar o app: ANUAL desconta 1 crédito (ou
// R$8 via Pix direto do cliente, ver AtivacaoPagamento) e expira 1 ano após
// a ativação; VITALICIO desconta 5 créditos (ou R$40 via Pix) e nunca
// expira (dataExpiracao fica null). TRIAL não custa crédito e expira 7 dias
// após a concessão — usado pela página admin "Instalados" para liberar um
// MAC recém-detectado sem cobrar do revendedor. Nulo em linhas antigas,
// criadas antes dessa cobrança existir.
enum TipoAtivacao {
  ANUAL
  VITALICIO
  TRIAL
}

// Uma linha por tentativa de compra de ativação Pix pelo próprio cliente
// final, direto na página pública "Ativar Dispositivo" (sem login, sem
// revendedor no meio). Mesma máquina de estado/idempotência que
// CreditPurchase (ver /api/app/ativacao/pagamento, .../status,
// .../webhook), mas em vez de somar créditos a um User, aplica a ativação
// (tipo + dataExpiracao) direto na Lista do App daquele mac.
model AtivacaoPagamento {
  id          Int                  @id @default(autoincrement())
  mac         String
  tipo        TipoAtivacao
  amount      Float
  status      CreditPurchaseStatus @default(PENDING)
  mpPaymentId String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([mac])
}

// Histórico de transferências de ativação entre MACs (ver
// /api/painel/listas/transferir). Guardado à parte da Lista porque o MAC de
// origem costuma ser apagado logo depois da transferência — sem isso não
// sobraria nenhum rastro de quem transferiu o quê e quando.
model TransferenciaAtivacao {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  macOrigem      String
  macDestino     String
  tipo           TipoAtivacao
  dataExpiracao  DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
}
